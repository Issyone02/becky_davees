# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_mgmt?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Super Admin bootstrap
SUPER_ADMIN_EMAIL="super-admin-@local.app"
SUPER_ADMIN_PASSWORD="YOUR-PASSWORD-HERE"
SUPER_ADMIN_FULL_NAME="System Super Admin"

# Mail (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@school.local"

# Redis (optional; falls back to in-memory cache if unset)
REDIS_URL="redis://localhost:6379"

# File storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100